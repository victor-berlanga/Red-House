+{% else %}<a class="{{ 'action-menu-item' if menu else 'icon-button' }}" href="{{ link }}" {% if glyph=='cancel' %}data-action-dialog{% elif glyph=='view' %}data-record-view="{{ link }}"{% endif %} aria-label="{{ label }} · {{ resource }}" {% if not menu %}data-tooltip="{{ label }} · {{ resource }}"{% endif %}>{{ icon(image) }}{% if menu %}{{ label }}{% endif %}</a>{% endif %}
