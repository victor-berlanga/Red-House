# Copiar a .env dentro de apps/web y completar LOCALMENTE.
APP_ENV=development
# Generar dos valores distintos: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
HOST=127.0.0.1
PORT=5000
# Highcharts se usa solo como evaluación académica. No se envían datos al CDN.
HIGHCHARTS_ENABLED=true
BACKEND_MODE=microservices
# Necesario solo en modo microservices; configuración privada creada por el provisionador.
MICROSERVICES_CONFIG=
