{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "items",
        "page",
        "page_size",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Id",
                "type": "string"
              },
              "donor_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Donor Id",
                "type": "string"
              },
              "tenant_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Tenant Id",
                "type": "string"
              },
              "author_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Author Id",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              },
              "policy_version": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Policy Version",
                "type": "string"
              },
              "reference": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Reference",
                "type": "string"
              },
              "effective_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Effective At",
                "type": "string"
              },
              "granted": {
                "title": "Granted",
                "type": "boolean"
              },
              "supersedes": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Supersedes"
              },
              "created_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Created At",
                "type": "string"
              }
            },
            "required": [
              "id",
              "donor_id",
              "tenant_id",
              "author_id",
              "version",
              "policy_version",
              "reference",
              "effective_at",
              "granted",
              "supersedes",
              "created_at"
            ],
            "title": "Consent",
            "type": "object"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
