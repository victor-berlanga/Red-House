{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "items",
        "page",
        "page_size",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Id",
                "type": "string"
              },
              "donor_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Donor Id",
                "type": "string"
              },
              "campaign_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Campaign Id",
                "type": "string"
              },
              "title": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "slot_id": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Slot Id"
              },
              "site_id": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Site Id"
              },
              "starts_at": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Starts At"
              },
              "ends_at": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Ends At"
              },
              "status": {
                "title": "Status",
                "type": "string"
              },
              "schedule_status": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Schedule Status"
              },
              "schedule_version": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Schedule Version"
              },
              "created_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Created At",
                "type": "string"
              }
            },
            "required": [
              "id",
              "donor_id",
              "campaign_id",
              "title",
              "slot_id",
              "site_id",
              "starts_at",
              "ends_at",
              "status",
              "schedule_status",
              "schedule_version",
              "created_at"
            ],
            "title": "AgendaAppointment",
            "type": "object"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
