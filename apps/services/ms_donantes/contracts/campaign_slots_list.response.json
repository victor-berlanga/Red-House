{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "items",
        "page",
        "page_size",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "campaign_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Campaign Id",
                "type": "string"
              },
              "site_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Site Id",
                "type": "string"
              },
              "starts_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Starts At",
                "type": "string"
              },
              "ends_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Ends At",
                "type": "string"
              },
              "capacity": {
                "maximum": 10000,
                "minimum": 1,
                "title": "Capacity",
                "type": "integer"
              },
              "id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Id",
                "type": "string"
              },
              "tenant_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Tenant Id",
                "type": "string"
              },
              "active": {
                "title": "Active",
                "type": "boolean"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              },
              "created_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Created At",
                "type": "string"
              },
              "campaign_title": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Campaign Title",
                "type": "string"
              },
              "site_name": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Site Name",
                "type": "string"
              },
              "occupied": {
                "title": "Occupied",
                "type": "integer"
              },
              "available": {
                "title": "Available",
                "type": "integer"
              },
              "attended": {
                "title": "Attended",
                "type": "integer"
              }
            },
            "required": [
              "campaign_id",
              "site_id",
              "starts_at",
              "ends_at",
              "capacity",
              "id",
              "tenant_id",
              "active",
              "version",
              "created_at",
              "campaign_title",
              "site_name",
              "occupied",
              "available",
              "attended"
            ],
            "title": "SlotAvailability",
            "type": "object"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
