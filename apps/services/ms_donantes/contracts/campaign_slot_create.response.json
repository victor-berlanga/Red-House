{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "campaign_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "site_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Site Id",
          "type": "string"
        },
        "starts_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Starts At",
          "type": "string"
        },
        "ends_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ends At",
          "type": "string"
        },
        "capacity": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Capacity",
          "type": "integer"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "campaign_id",
        "site_id",
        "starts_at",
        "ends_at",
        "capacity",
        "id",
        "tenant_id",
        "active",
        "version",
        "created_at"
      ],
      "title": "Slot",
      "type": "object"
    }
  }
}
