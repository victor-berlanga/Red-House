{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "BLOOD",
            "ORGAN"
          ],
          "title": "Kind",
          "type": "string"
        },
        "component": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "minimum_c": {
          "maximum": 100,
          "minimum": -273.15,
          "title": "Minimum C",
          "type": "number"
        },
        "maximum_c": {
          "maximum": 100,
          "minimum": -273.15,
          "title": "Maximum C",
          "type": "number"
        },
        "max_gap_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Gap Seconds",
          "type": "integer"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "effective_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Effective At",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "author_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Author Id",
          "type": "string"
        },
        "created_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "component",
        "minimum_c",
        "maximum_c",
        "max_gap_seconds",
        "source",
        "synthetic",
        "effective_at",
        "id",
        "tenant_id",
        "author_id",
        "created_at"
      ],
      "title": "ColdProfile",
      "type": "object"
    }
  }
}
