{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "system": {
          "maxLength": 200,
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "external_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Resource Id",
          "type": "string"
        },
        "author_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Author Id",
          "type": "string"
        },
        "created_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "system",
        "external_id",
        "resource_id",
        "author_id",
        "created_at"
      ],
      "title": "Mapping",
      "type": "object"
    }
  }
}
