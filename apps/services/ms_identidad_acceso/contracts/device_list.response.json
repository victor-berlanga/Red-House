{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Id",
                "type": "string"
              },
              "tenant_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Tenant Id",
                "type": "string"
              },
              "user_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "User Id",
                "type": "string"
              },
              "source": {
                "enum": [
                  "SIMULATOR",
                  "GPS_BRIDGE",
                  "ANDROID"
                ],
                "title": "Source",
                "type": "string"
              },
              "label": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "expires_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Expires At",
                "type": "string"
              },
              "active": {
                "title": "Active",
                "type": "boolean"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              },
              "created_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Created At",
                "type": "string"
              }
            },
            "required": [
              "id",
              "tenant_id",
              "user_id",
              "source",
              "label",
              "expires_at",
              "active",
              "version",
              "created_at"
            ],
            "title": "Device",
            "type": "object"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
