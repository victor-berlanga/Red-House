{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Profile Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "DRAFT",
            "IN_REVIEW",
            "APPROVED",
            "RETIRED"
          ],
          "title": "State",
          "type": "string"
        },
        "actions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Id",
                "type": "string"
              },
              "profile_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Profile Id",
                "type": "string"
              },
              "tenant_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Tenant Id",
                "type": "string"
              },
              "actor_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Actor Id",
                "type": "string"
              },
              "sequence": {
                "title": "Sequence",
                "type": "integer"
              },
              "state": {
                "enum": [
                  "IN_REVIEW",
                  "APPROVED",
                  "RETIRED"
                ],
                "title": "State",
                "type": "string"
              },
              "reason": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Reason",
                "type": "string"
              },
              "competency_reference": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Competency Reference"
              },
              "evidence": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Evidence"
              },
              "created_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Created At",
                "type": "string"
              }
            },
            "required": [
              "id",
              "profile_id",
              "tenant_id",
              "actor_id",
              "sequence",
              "state",
              "reason",
              "competency_reference",
              "evidence",
              "created_at"
            ],
            "title": "RecordedAction",
            "type": "object"
          },
          "title": "Actions",
          "type": "array"
        },
        "invalid_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Invalid Reasons",
          "type": "array"
        },
        "clinical_enabled": {
          "title": "Clinical Enabled",
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "ACADEMIC",
            "CLINICAL"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "state",
        "actions",
        "invalid_reasons",
        "clinical_enabled",
        "scope"
      ],
      "title": "Governance",
      "type": "object"
    }
  }
}
