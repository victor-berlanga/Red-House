# Catálogo de variables; no distribuir este archivo completo a todos los procesos.
# Usar el .env.example exclusivo de cada unidad; valores reales fuera de Git.
# No reutilizar credenciales del monolito.
# REDHOUSE_ENV=/ruta/privada/microservicios.env
IDENTIDAD_ACCESO_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_identidad_acceso%2Cpg_catalog
DONANTES_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_donantes%2Cpg_catalog
RECEPTORES_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_receptores%2Cpg_catalog
INVENTARIO_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_inventario%2Cpg_catalog
COMPATIBILIDAD_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_compatibilidad%2Cpg_catalog
PRIORIZACION_GEOGRAFIA_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_priorizacion_geografia%2Cpg_catalog
TRANSPORTE_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_transporte%2Cpg_catalog
CUSTODIA_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_custodia%2Cpg_catalog
ALERTAS_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_alertas%2Cpg_catalog
AUDITORIA_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_auditoria%2Cpg_catalog
MONITOREO_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_monitoreo%2Cpg_catalog
REDIS_URL=redis://:CAMBIAR@127.0.0.1:6379/0
REDIS_PREFIX=redhouse-ms:
TRANSPORTE_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_transporte
CUSTODIA_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_custodia
AUDITORIA_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_auditoria
MONITOREO_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_monitoreo
JWT_PUBLIC_KEY=PEM_PUBLICO_RS256_CON_SALTOS_ESCAPADOS
# Solo identidad recibe JWT_PRIVATE_KEY. Cada servicio recibe solo su clave Ed25519 privada.
JWT_PRIVATE_KEY=PEM_PRIVADO_RS256_CON_SALTOS_ESCAPADOS
IDENTIDAD_ACCESO_SERVICE_PRIVATE_KEY=PEM_PRIVADO_ED25519
SERVICE_PUBLIC_KEYS={}
SERVICE_URLS={"identidad_acceso":"http://127.0.0.1:5101","donantes":"http://127.0.0.1:5102","receptores":"http://127.0.0.1:5103","inventario":"http://127.0.0.1:5104","compatibilidad":"http://127.0.0.1:5105","priorizacion_geografia":"http://127.0.0.1:5106","transporte":"http://127.0.0.1:5107","custodia":"http://127.0.0.1:5108","alertas":"http://127.0.0.1:5109","auditoria":"http://127.0.0.1:5110","monitoreo":"http://127.0.0.1:5111","documentos":"http://127.0.0.1:5112"}
# GCS es opcional en este incremento. Producción requiere bucket privado, ADC y firma V4.
GCS_BUCKET=

# Entrega final. Políticas operativas seguras; TESTING no debe usarse en producción.
MFA_REQUIRED_ROLES=["ADMIN","MEDICAL","COORDINATOR"]
REAUTH_REQUIRED_OPERATIONS=["resource_release","lab_result_review","reservation_create","resource_destination"]
REQUIRE_ORGAN_AUTHORIZATION=true
REQUIRE_LAB_PROFILE=true
# SMTP/Push autorizados y ClamD en red privada. Nunca versionar valores reales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUSH_ADAPTER_URL=
PUSH_ADAPTER_TOKEN=
CLAMD_HOST=
CLAMD_PORT=3310
# WSS y límites se definen en el JSON privado del servicio Transporte.
# Consultar documentation/entrega-final/backend/Rastreo.md.

# Documentos posee archivos/reportes; Transporte solo delega rutas v1.
DOCUMENTOS_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/red_house?options=-csearch_path%3Daccess_documentos%2Cpg_catalog
DOCUMENTOS_SERVICE_PRIVATE_KEY=PEM_PRIVADO_ED25519_EXCLUSIVO

# Optional pinned public HLA catalogue, installed explicitly; no request-time downloads.
# HLA_REFERENCE_DIR=/absolute/read-only/path/to/reference-data/hla
