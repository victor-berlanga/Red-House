# Catálogo de variables; no distribuir este archivo completo a todos los procesos.
# Usar el .env.example exclusivo de cada unidad; valores reales fuera de Git.
# No reutilizar credenciales del monolito.
# REDHOUSE_ENV=/ruta/privada/microservicios.env
IDENTIDAD_ACCESO_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_identidad_acceso?options=-csearch_path%3Dapi
DONANTES_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_donantes?options=-csearch_path%3Dapi
RECEPTORES_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_receptores?options=-csearch_path%3Dapi
INVENTARIO_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_inventario?options=-csearch_path%3Dapi
COMPATIBILIDAD_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_compatibilidad?options=-csearch_path%3Dapi
PRIORIZACION_GEOGRAFIA_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_priorizacion_geografia?options=-csearch_path%3Dapi
TRANSPORTE_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_transporte?options=-csearch_path%3Dapi
CUSTODIA_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_custodia?options=-csearch_path%3Dapi
ALERTAS_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_alertas?options=-csearch_path%3Dapi
AUDITORIA_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_auditoria?options=-csearch_path%3Dapi
MONITOREO_DATABASE_URL=postgresql://USUARIO:CAMBIAR@127.0.0.1:5432/rh_monitoreo?options=-csearch_path%3Dapi
REDIS_URL=redis://:CAMBIAR@127.0.0.1:6379/0
REDIS_PREFIX=redhouse-ms:
TRANSPORTE_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_transporte
CUSTODIA_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_custodia
AUDITORIA_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_auditoria
MONITOREO_MONGODB_URL=mongodb://USUARIO:CAMBIAR@127.0.0.1:27017/rh_monitoreo
JWT_PUBLIC_KEY=PEM_PUBLICO_RS256_CON_SALTOS_ESCAPADOS
# Solo identidad recibe JWT_PRIVATE_KEY. Cada servicio recibe solo su clave Ed25519 privada.
JWT_PRIVATE_KEY=PEM_PRIVADO_RS256_CON_SALTOS_ESCAPADOS
IDENTIDAD_ACCESO_SERVICE_PRIVATE_KEY=PEM_PRIVADO_ED25519
SERVICE_PUBLIC_KEYS={}
SERVICE_URLS={"identidad_acceso":"http://127.0.0.1:5101","donantes":"http://127.0.0.1:5102","receptores":"http://127.0.0.1:5103","inventario":"http://127.0.0.1:5104","compatibilidad":"http://127.0.0.1:5105","priorizacion_geografia":"http://127.0.0.1:5106","transporte":"http://127.0.0.1:5107","custodia":"http://127.0.0.1:5108","alertas":"http://127.0.0.1:5109","auditoria":"http://127.0.0.1:5110","monitoreo":"http://127.0.0.1:5111"}
# GCS es opcional en este incremento. Producción requiere bucket privado, ADC y firma V4.
GCS_BUCKET=
