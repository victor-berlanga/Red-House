{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "authority": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Authority",
          "type": "string"
        },
        "reference": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "valid_from": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Valid Until",
          "type": "string"
        },
        "effective_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Effective At",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "decision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "author_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Author Id",
          "type": "string"
        },
        "created_at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "request_id",
        "tenant_id",
        "authority",
        "reference",
        "valid_from",
        "valid_until",
        "effective_at",
        "supersedes",
        "decision",
        "version",
        "author_id",
        "created_at"
      ],
      "title": "Authorization",
      "type": "object"
    }
  }
}
