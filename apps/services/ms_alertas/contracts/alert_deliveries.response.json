{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "items",
        "page",
        "page_size",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Id",
                "type": "string"
              },
              "alert_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Alert Id",
                "type": "string"
              },
              "subscription_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Subscription Id",
                "type": "string"
              },
              "tenant_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Tenant Id",
                "type": "string"
              },
              "stage": {
                "title": "Stage",
                "type": "string"
              },
              "status": {
                "title": "Status",
                "type": "string"
              },
              "attempts": {
                "title": "Attempts",
                "type": "integer"
              },
              "next_attempt": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Next Attempt",
                "type": "string"
              },
              "accepted_at": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Accepted At"
              },
              "last_error": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Last Error"
              },
              "created_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Created At",
                "type": "string"
              }
            },
            "required": [
              "id",
              "alert_id",
              "subscription_id",
              "tenant_id",
              "stage",
              "status",
              "attempts",
              "next_attempt",
              "accepted_at",
              "last_error",
              "created_at"
            ],
            "title": "Delivery",
            "type": "object"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
