{
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "correlation_id",
        "service",
        "version"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Event Id",
                "type": "string"
              },
              "source": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Source",
                "type": "string"
              },
              "action": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Action",
                "type": "string"
              },
              "resource_id": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Resource Id",
                "type": "string"
              },
              "tenant_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Tenant Id",
                "type": "string"
              },
              "region_id": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Region Id"
              },
              "actor_id": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Actor Id"
              },
              "correlation_id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "title": "Correlation Id",
                "type": "string"
              },
              "occurred_at": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Occurred At",
                "type": "string"
              },
              "metadata": {
                "additionalProperties": true,
                "title": "Metadata",
                "type": "object"
              }
            },
            "required": [
              "event_id",
              "source",
              "action",
              "resource_id",
              "tenant_id",
              "region_id",
              "actor_id",
              "correlation_id",
              "occurred_at",
              "metadata"
            ],
            "title": "Event",
            "type": "object"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "items",
        "page",
        "page_size",
        "total"
      ]
    }
  }
}
